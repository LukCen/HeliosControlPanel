{
  "name": "helios_v3",
  "version": "0.0.3",
  "description": "A connection manager for personal use.",
  "main": "dist/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:main": "esbuild src/main.ts --bundle --platform=node --outfile=dist/main.js --external:electron",
    "build:preload": "esbuild src/preload.ts --bundle --platform=node --outfile=dist/preload.js --external:electron",
    "build:renderer": "esbuild src/renderer.ts --bundle --platform=browser --outfile=dist/renderer.js --external:electron",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "twcompile": "npx @tailwindcss/cli -i ./public/assets/input.css -o ./public/assets/output.css",
    "start": "npm run twcompile && npm run build && electron dist/main.js"
  },
  "author": "Łukasz Cena",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.1",
    "electron": "^35.1.5",
    "esbuild": "^0.25.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.4",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mysql2": "^3.14.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.4"
  }
}
